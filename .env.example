# payOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/checkout/success
PAYOS_CANCEL_URL=http://localhost:5173/checkout/cancel

# App runtime
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
JPA_SHOW_SQL=true
UPLOAD_DIR=uploads

# Database and Redis
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ticketrush
SPRING_DATASOURCE_USERNAME=ticketrush
SPRING_DATASOURCE_PASSWORD=ticketrush
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=

# Optional
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=""
RECAPTCHA_MIN_SCORE=0.5
UPLOAD_DIR=uploads
VIRTUAL_QUEUE_ENABLED=true
VIRTUAL_QUEUE_MAX_ACTIVE_USERS=100
VIRTUAL_QUEUE_RELEASE_BATCH_SIZE=100
VIRTUAL_QUEUE_ACCESS_TTL_SECONDS=300

# seats.io provider workspaces
SEATSIO_REGION=oc
SEATSIO_ADMIN_KEY=
SEATSIO_SANDBOX=false
